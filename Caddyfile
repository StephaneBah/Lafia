# Passerelle : la seule entrée publique de Lafia.
# Chaque application a son sous-domaine ; sur ce sous-domaine, /api/<son service>/* va à son
# service, /api/identite/* à identite, tout autre /api/* reçoit 404, et le reste va à l'application.
# Le domaine lui-même sert le site produit, qui n'appelle aucun service : tout /api/* y reçoit 404.
#
# LAFIA_DOMAINE vaut localhost en local : Caddy signe alors les certificats de
# soin.localhost, … par son autorité interne. Sur un vrai domaine, il les obtient
# et les renouvelle auprès d'une autorité publique.
#
# Chaque sous-domaine a aussi une entrée interne, http://<sous-domaine>:8080, que seul le réseau
# passerelle atteint (le port n'est pas publié) : le serveur d'une application y joint son service
# en HTTP, par les mêmes règles que le public.
{
	# L'autorité interne reste dans le conteneur : pas d'installation dans un magasin système.
	skip_install_trust
	# Pas de HTTP/3 : il passe par UDP 443, que la pile ne publie pas. L'annoncer ferait tenter
	# aux navigateurs une connexion vouée à l'échec.
	servers {
		protocols h1 h2
	}
}

# Sur toute réponse, page, API ou refus, du site comme de chaque application : HTTPS seul, pas
# d'interprétation du type, jamais dans le cadre d'un autre site, aucune adresse transmise en référent
# à un autre site (elle peut porter un identifiant). Vers la même origine, le navigateur garde son
# origine : identite n'accepte un formulaire que s'il la porte, et `no-referrer` la remplacerait par
# `null`. La caméra reste permise : la caisse et la pharmacie liront le QR code de l'ordonnance.
# Rien ne nomme le logiciel derrière la passerelle.
(en-tetes) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=()"
		-Server
		-X-Powered-By
		-Via
	}
}

# La règle de tout acteur : `import acteur <nom> <borne>` sert <nom>.<domaine>, où son service est le
# conteneur <nom> et son application le conteneur application-<nom>.
# Caddy ne borne pas le corps d'une requête par défaut : chaque acteur a la sienne. Seuls soin et
# numerisation reçoivent des Documents, jusqu'à 20 pages de 3 Mo (ADR 0008), enveloppe comprise :
# 64 Mo. Les autres n'envoient que des formulaires et du JSON : 1 Mo. Le service refuse ce qui dépasse
# ses propres limites, en 413.
(acteur) {
	{args[0]}.{$LAFIA_DOMAINE}, http://{args[0]}.{$LAFIA_DOMAINE}:8080 {
		import en-tetes
		request_body {
			max_size {args[1]}
		}
		handle /api/{args[0]}/* {
			reverse_proxy {args[0]}:8000
		}
		handle /api/identite/* {
			reverse_proxy identite:8000
		}
		handle /api/* {
			respond 404
		}
		handle {
			reverse_proxy application-{args[0]}:3000
		}
	}
}

import acteur soin 64MB
import acteur caisse 1MB
import acteur pharmacie 1MB
import acteur citoyen 1MB
import acteur numerisation 64MB
import acteur relecture 1MB
# Le service extraction n'a pas de site : aucune route n'y mène, seul relecture le joint (ADR 0009).

# Le site produit, sur le domaine lui-même : la vision, et un lien vers chaque application. Il n'a pas
# d'entrée interne, n'appelle aucun service et n'en expose aucun.
{$LAFIA_DOMAINE} {
	import en-tetes
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy application-site:3000
	}
}
