# Variables de la pile Lafia. Copier en .env (ignoré par git) et fixer chaque valeur.
# Sans .env, docker-compose.yml prend des valeurs de développement local.

# Domaine de base : chaque application est servie sur <application>.<domaine>.
# En local, localhost : Caddy signe les certificats par son autorité interne.
LAFIA_DOMAINE=localhost

# Mot de passe de la base PostgreSQL du noyau.
# En production, une valeur longue et aléatoire, par exemple : openssl rand -base64 32
NOYAU_BASE_MOT_DE_PASSE=

# Mot de passe de la base PostgreSQL d'identite : comptes, codes carnet, sessions.
# En production, une valeur longue et aléatoire, par exemple : openssl rand -base64 32
# PostgreSQL garde le premier mot de passe qu'il reçoit : le fixer avant le premier démarrage.
IDENTITE_BASE_MOT_DE_PASSE=

# Clé publique Ed25519 qui vérifie les jetons de session, lue par chaque service qui en reçoit.
# La clé privée, qui les signe, n'est tenue que par identite et n'est jamais commitée.
# Créer une paire, puis copier ici la ligne base64 entre les bornes du PEM de la clé publique :
#   openssl genpkey -algorithm ed25519 -out identite.pem
#   openssl pkey -in identite.pem -pubout
# Vide, sur localhost seulement, les services prennent la clé de développement, dont la clé privée
# est publique. Sur tout autre domaine, ils refusent de démarrer sans une clé, et refusent la clé de
# développement.
JETON_CLE_PUBLIQUE=

# Clé privée de la même paire : la ligne base64 entre les bornes du PEM de identite.pem.
# identite seul la lit, pour signer les jetons ; elle ne quitte jamais la machine de la pile. Même
# règle que la clé publique : vide sur localhost seulement, jamais celle de développement ailleurs.
# Sur la VM, deploiement/preparer-vm.sh l'écrit dans .env avec la clé publique.
JETON_CLE_PRIVEE=
